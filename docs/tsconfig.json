{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "unplugin-icons/types/vue"],
    "paths": {
      "@/*": ["./*"],
      "@vue-stack/table": ["../packages/table/src/index.ts"],
      "@vue-stack/table/drag-and-drop": ["../packages/table/src/drag-and-drop.ts"],
      "@vue-stack/table-core": ["../packages/table-core/src/index.ts"],
      "@vue-stack/drag-and-drop": ["../packages/drag-and-drop/src/index.ts"],
      "@vue-stack/flip": ["../packages/flip/src/index.ts"]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "demos/**/*.ts",
    "demos/**/*.vue",
    "data/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.vue",
    "tests/**/*.ts",
    "vitest.config.ts",
    "../packages/table/src/env.d.ts"
  ]
}
