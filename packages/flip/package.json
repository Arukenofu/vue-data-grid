{
  "name": "@vue-data-grid/flip",
  "version": "0.0.0",
  "description": "Pluggable FLIP transitions: measure elements before a DOM change, and let any animation engine play what moved, came and went.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "animation",
    "flip",
    "transition",
    "web-animations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "lint:package": "publint"
  },
  "publishConfig": {
    "access": "public"
  }
}
