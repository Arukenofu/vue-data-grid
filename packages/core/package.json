{
  "name": "@vue-data-grid/core",
  "version": "0.0.1",
  "description": "Headless Vue data grid on top of @vue-data-grid/engine, which it re-exports: a grid assembled in one call, headless components, ARIA grid props, service columns, keyboard navigation, column resize, autosize, structural CSS, and dragging rows and columns with @vue-data-grid/drag-and-drop.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "vue",
    "table",
    "data-grid",
    "keyboard",
    "accessibility"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drag-and-drop": {
      "types": "./dist/drag-and-drop.d.ts",
      "default": "./dist/drag-and-drop.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "lint:package": "publint"
  },
  "dependencies": {
    "@vue-data-grid/flip": "workspace:^",
    "@vue-data-grid/engine": "workspace:^"
  },
  "peerDependencies": {
    "@vue-data-grid/drag-and-drop": "workspace:^",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vue-data-grid/drag-and-drop": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue-data-grid/drag-and-drop": "workspace:*",
    "vue": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
